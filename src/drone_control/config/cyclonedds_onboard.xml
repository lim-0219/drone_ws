<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS on the ONBOARD COMPUTER (Raspberry Pi 5) for the real vehicle.

  Wi-Fi multicast is unreliable, so discovery is done by unicast to the ground
  PC's fixed address, and DDS is pinned to the Wi-Fi interface so it never tries
  the Ethernet port. Both machines must use the same ROS_DOMAIN_ID (7).

  The 10 MB receive buffer matters on the Pi itself: the camera node sends
  6.9 MB frames to the navigator over the loopback and the kernel default
  (net.core.rmem_max = 212992) drops fragments. Raise the kernel limit once:
      sudo sysctl -w net.core.rmem_max=2147483647 net.core.rmem_default=2147483647
  (persist it in /etc/sysctl.d/60-ros2-dds.conf; see README "Large camera images").

  Edit: NetworkInterface name (ip a: wlan0 on the Pi 5) and the ground PC address.
  Use:  export CYCLONEDDS_URI=file://$HOME/drone_ws/install/drone_control/share/drone_control/config/cyclonedds_onboard.xml
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="wlan0" priority="default" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer address="192.168.4.10"/>   <!-- ground PC -->
        <Peer address="127.0.0.1"/>      <!-- nodes on this Pi -->
      </Peers>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize max="10MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
